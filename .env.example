NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_WEBAPP_URL=https://example.com
TMA_URL=https://example.com
WEB_APP_URL=https://example.com
TMA_APP_URL=https://example.com
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://example.com/api/oauth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-random-oauth-state-secret
# Crypto-at-rest key for all external credentials/tokens. Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-random-secret
LIFEOS_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-random-secret
LIFEOS_HEALTH_INGEST_JWT_SECRET=replace-with-random-health-jwt-secret
SYNCTHING_API_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=replace-with-local-syncthing-api-key
SYNCTHING_SERVER_DEVICE_ID=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
# Legacy static secret is disabled unless LIFEOS_ALLOW_LEGACY_HEALTH_INGEST_SECRET=true.
# Legacy/dev only. Multi-user Obsidian mirror reads per-user vaults from user_obsidian_settings.
OBSIDIAN_VAULT_PATH=/path/to/obsidian/vault
LIFEOS_ADMIN_TELEGRAM_IDS=123456789
LIFEOS_SIGNUP_MODE=pending_approval
REMINDER_WORKER_POLL_SECONDS=30
REMINDER_WORKER_BATCH_SIZE=20
REMINDER_WORKER_TEST_TELEGRAM_USER_ID=123456789

# Legacy single-user workers are disabled unless explicitly accepted.
# Keep Google/ICS/monthly-review false until per-user source routing exists.
LIFEOS_ENABLE_LEGACY_SINGLE_USER_GOOGLE_SYNC=false
LIFEOS_ENABLE_LEGACY_SINGLE_USER_ICS_SYNC=false
LIFEOS_ENABLE_LEGACY_SINGLE_USER_MONTHLY_REVIEW=false
# Obsidian uses user_obsidian_settings by default; this flag only enables OBSIDIAN_VAULT_PATH fallback.
LIFEOS_ENABLE_LEGACY_SINGLE_USER_OBSIDIAN=false
