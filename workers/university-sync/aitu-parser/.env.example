# ── Supabase (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
LIFEOS_DEFAULT_USER_ID=replace-with-user-uuid
APP_TIMEZONE=Asia/Qyzylorda

# ── Legacy single-user guard (must be 'true' for local/dev use) ───────────────
LIFEOS_ENABLE_LEGACY_SINGLE_USER_UNIVERSITY_SYNC=false

# ── AITU LMS credentials ──────────────────────────────────────────────────────
# AITU's Moodle (lms.astanait.edu.kz) has NO native username/password login —
# only "OpenID Connect" (Microsoft Entra ID / Azure AD SSO). UNIVERSITY_USERNAME
# / UNIVERSITY_PASSWORD below are still required fields (the shared BaseSettings
# loader expects them) but will not actually authenticate anything for AITU
# accounts; leave them as any non-empty placeholder unless you have a genuine
# Moodle-local account. Use one of the two options below instead:
UNIVERSITY_USERNAME=your_student_id_or_email
UNIVERSITY_PASSWORD=your_password

# Option A (preferred, most reliable): Moodle Web Services token.
# Generate at: https://lms.astanait.edu.kz/user/managetoken.php
# Required capabilities: gradereport/user:view, moodle/grade:view
# If your account doesn't have access to that page (many students don't),
# use Option B instead.
UNIVERSITY_WS_TOKEN=

# Option B: Microsoft SSO persistent-session cookie. Needed when there is no
# Web Services access. Sign into AITU normally in a browser, then:
#   1. Open devtools (F12) → Application tab → Cookies →
#      https://login.microsoftonline.com
#   2. Copy the value of the ESTSAUTHPERSISTENT cookie.
#   3. Paste it here. It is a long-lived (weeks) session cookie, not a
#      short-lived token, so this can run unattended — but it WILL expire
#      eventually (Microsoft session lifetime policy, or if you sign out
#      elsewhere) and need to be refreshed by repeating the steps above.
UNIVERSITY_SSO_COOKIE=

# If both options above are empty or fail, the sync will raise an error rather
# than silently fabricating grade data. To explicitly allow mock data instead
# (e.g. local pipeline testing), set:
AITU_SYNC_MOCK_MODE=false

# ── Polling ───────────────────────────────────────────────────────────────────
# Interval between sync runs in run-loop mode (seconds). Default: 3600 (1 hour).
UNIVERSITY_SYNC_POLL_SECONDS=3600
