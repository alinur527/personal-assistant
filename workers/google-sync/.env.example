# Production multi-user worker. Values must match the OAuth client used by the
# bot callback. The service role and encryption key are trusted-worker secrets.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
LIFEOS_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-the-same-32-byte-key-as-the-bot
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/tasks.readonly,https://www.googleapis.com/auth/userinfo.email
GOOGLE_SYNC_LOOKAHEAD_DAYS=14
GOOGLE_SYNC_POLL_SECONDS=300
GOOGLE_SYNC_CALENDAR_IDS=primary
GOOGLE_SYNC_TASKLIST_IDS=@default
APP_TIMEZONE=Asia/Qyzylorda

# Legacy/dev only. Set true only to use `auth` and one local token.json.
LIFEOS_ENABLE_LEGACY_SINGLE_USER_GOOGLE_SYNC=false
GOOGLE_CLIENT_SECRETS_FILE=/home/zalewko/lifeos/workers/google-sync/secrets/client_secret.json
GOOGLE_TOKEN_FILE=/home/zalewko/lifeos/workers/google-sync/secrets/token.json
LIFEOS_DEFAULT_USER_ID=replace-with-user-uuid
