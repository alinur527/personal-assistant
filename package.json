{
  "name": "lifeos",
  "version": "0.0.0",
  "private": true,
  "description": "Personal LifeOS monorepo.",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "selfhost:build-tma": "bash scripts/build-tma-selfhost.sh",
    "selfhost:deploy": "bash scripts/deploy-selfhost.sh",
    "selfhost:status": "bash scripts/status-selfhost.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "prettier": "^3.5.3",
    "supabase": "2.117.0-beta.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
