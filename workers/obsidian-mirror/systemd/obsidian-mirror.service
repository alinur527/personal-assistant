[Unit]
Description=LifeOS Obsidian Mirror Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lifeos
Group=lifeos
WorkingDirectory=/opt/lifeos/workers/obsidian-mirror
EnvironmentFile=/etc/lifeos/obsidian-mirror.env
ExecStart=/usr/bin/python /opt/lifeos/workers/obsidian-mirror/obsidian_mirror.py run-loop
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/obsidian-vaults

[Install]
WantedBy=multi-user.target
